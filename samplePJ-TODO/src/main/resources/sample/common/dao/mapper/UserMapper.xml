<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTM Mapper 3.0//EN"
		"http://mybatis.org/dtdmybatis-3-mapper.dtd">
		
<mapper namespace="sample.common.dao.mapper.UserMapper">

	<!-- ログイン用ユーザー検索 -->
	<select id="userSearch"
			parameterType="sample.common.dao.entity.User"
			resultType="sample.common.dao.entity.User">
			
		SELECT 
			id,
			email_address,
			password,
			name,
			created_at,
			updated_at,
		FROM users
		WHERE email_address = #{email_address}
		AND   password = #{password}
		LIMIT 1		
			
	</select>
</mapper>		